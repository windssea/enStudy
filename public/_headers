/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/content/*
  Cache-Control: public, max-age=300

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/audio/phonics/*.wav
  Cache-Control: public, max-age=31536000, immutable

/offline-sw.js
  Cache-Control: no-cache

/offline-shell.json
  Cache-Control: no-store
