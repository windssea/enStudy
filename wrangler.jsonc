{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-quest-dev",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-17",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "english-quest-dev-db",
      "database_id": "28fdeae4-7ebe-409f-9beb-2766122fa159",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_STAGE": "preview",
    "ALLOW_DEV_AUTH": "false",
  },
  "env": {
    "production": {
      "vars": {
        "APP_STAGE": "production",
        "ALLOW_DEV_AUTH": "false",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "english-quest-prod-db",
          "database_id": "bfbbf58a-56fc-4173-bfa4-81442a15e257",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
