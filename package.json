{
  "name": "english-quest",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "wrangler pages dev dist --ip 127.0.0.1 --port 8788",
    "content:build": "node scripts/build-content.mjs",
    "build": "npm run content:build && tsc --noEmit && vite build",
    "check": "tsc --noEmit && vitest run",
    "check:functions": "wrangler pages functions build --outdir .wrangler/functions-build",
    "format": "prettier --write src packages functions scripts tests package.json tsconfig.json vite.config.ts wrangler.jsonc cloudflare.project.json",
    "format:check": "prettier --check src packages functions scripts tests package.json tsconfig.json vite.config.ts wrangler.jsonc cloudflare.project.json",
    "test": "vitest run",
    "setup:local": "node scripts/setup-local.mjs",
    "setup:ai:local": "node scripts/prepare-local-ai.mjs",
    "verify:ai": "node scripts/smoke-ai.mjs",
    "verify:voice": "node scripts/smoke-voice.mjs",
    "verify:workshops": "node scripts/smoke-workshops.mjs",
    "verify:listening-reading": "node scripts/smoke-listening-reading.mjs",
    "verify:concepts": "node scripts/smoke-concepts.mjs",
    "verify:action-courses": "node scripts/smoke-action-courses.mjs",
    "verify:discovery-courses": "node scripts/smoke-discovery-courses.mjs",
    "verify:reports": "node scripts/smoke-reports.mjs",
    "verify:offline": "node scripts/smoke-offline.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:whoami": "wrangler whoami",
    "cf:plan": "node scripts/cloudflare.mjs plan",
    "cf:provision": "node scripts/cloudflare.mjs provision",
    "cf:deploy:preview": "node scripts/cloudflare.mjs deploy",
    "verify:local": "node scripts/smoke-local.mjs",
    "verify:remote": "node scripts/smoke-remote.mjs",
    "verify:account": "node scripts/smoke-account.mjs",
    "verify:managed-accounts": "node scripts/smoke-managed-accounts.mjs",
    "verify:ownership": "node scripts/smoke-session-ownership.mjs",
    "verify:course": "node scripts/smoke-course.mjs",
    "verify:course-expansion": "node scripts/smoke-course-expansion.mjs",
    "verify:topics": "node scripts/smoke-topics.mjs",
    "verify:training": "node scripts/smoke-training.mjs",
    "verify:patterns": "node scripts/smoke-patterns.mjs",
    "verify:vocabulary": "node scripts/smoke-vocabulary.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "cf:provision:production": "node scripts/cloudflare.mjs provision --production",
    "cf:deploy:production": "node scripts/cloudflare.mjs deploy --production",
    "verify:production": "node scripts/smoke-remote.mjs https://english-quest-dev.pages.dev production",
    "verify:isolation": "node scripts/smoke-isolation.mjs",
    "verify:journey-courses": "node scripts/smoke-journey-courses.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "csv-parse": "^6.0.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261012.1-beta",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
